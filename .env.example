# Local SQLite path (default: data/ids.db)
IDS_DB_PATH=data/ids.db

# Enable ML only after training a model artifact in models/
IDS_ENABLE_ML=false
IDS_MODEL_PATH=models/random_forest_model.joblib

# Optional write-endpoint key. Leave blank for a local-only student demo.
# If set, send X-API-Key from the browser UI or IDS_API_KEY from the simulator.
IDS_API_KEY=

# Local development bind. Public Render deployment is separately configured in render.yaml
# with a generated IDS_API_KEY; keep the app synthetic-only.
IDS_HOST=127.0.0.1
IDS_PORT=8000
IDS_SEED_DEMO=true
