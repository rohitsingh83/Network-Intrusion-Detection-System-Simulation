# Network IDS Simulation Configuration
# Copy to .env and modify as needed

# Database
DATABASE_PATH=data/ids_database.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# IDS Configuration
ML_ENABLED=true
MODEL_PATH=models/ids_model.joblib

# Risk Weights (must sum to 1.0)
RULE_WEIGHT=0.4
ANOMALY_WEIGHT=0.3
ML_WEIGHT=0.3

# Alert Thresholds
ALERT_MIN_RISK_SCORE=20

# Correlation
CORRELATION_TIME_WINDOW=60
CORRELATION_MAX_GROUP=100

# Traffic Simulator
SIMULATOR_MODE=mixed
SIMULATOR_SPEED=fast
